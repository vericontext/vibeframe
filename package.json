{
  "name": "vibeframe",
  "version": "0.115.1",
  "description": "Frontier AI video generation for coding agents - Seedance, Runway, Veo, and Kling on your own keys, behind a hard cost cap. CLI + MCP.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vericontext/vibeframe.git"
  },
  "homepage": "https://vibeframe.ai",
  "bugs": {
    "url": "https://github.com/vericontext/vibeframe/issues"
  },
  "keywords": [
    "vibeframe",
    "ai-video",
    "video-generation",
    "text-to-video",
    "image-to-video",
    "seedance",
    "runway",
    "veo",
    "kling",
    "ai-agent",
    "cli",
    "mcp",
    "ffmpeg"
  ],
  "author": "VibeFrame Contributors",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:dogfood": "tsx scripts/dogfood-smoke.mts",
    "dogfood:paid": "tsx scripts/paid-dogfood.mts",
    "lint": "turbo lint",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "vibe": "tsx packages/cli/src/index.ts",
    "dev:setup": "tsx scripts/dev-setup-wizard.mts",
    "mcp": "tsx packages/mcp-server/src/index.ts",
    "scaffold:provider": "tsx scripts/scaffold-provider.mts",
    "scaffold:command": "tsx scripts/scaffold-command.mts",
    "agent-sync": "tsx scripts/sync-agent-hosts.mts --write",
    "agent-sync:check": "tsx scripts/sync-agent-hosts.mts --check",
    "gen:reference": "tsx scripts/gen-cli-reference.mts",
    "gen:reference:check": "tsx scripts/gen-cli-reference.mts --check",
    "hooks:install": "git config core.hooksPath .githooks",
    "package:check": "tsx scripts/package-smoke.mts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
