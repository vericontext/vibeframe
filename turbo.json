{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["VIBE_TEST_INTEGRATION"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/vitest-hermetic-env.mts"]
    },
    "clean": {
      "cache": false
    }
  }
}
